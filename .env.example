 # S1-N2 Integrated Environment Configuration
#
# 使い方: このファイルをコピーして .env に名前を変え、各値を環境に合わせて設定する
#   cp .env.example .env

# ディレクトリ名に依存しない固定プロジェクト名（変更不要）
COMPOSE_PROJECT_NAME=s1n2-gw

# ============ NETWORK ============
MCC=001
MNC=01
TAC=1

# ============ DATABASE & UI ============
MONGO_IP=172.24.0.2
WEBUI_IP=172.24.0.3

# ============ 5G CORE NETWORK ============
NRF_IP=172.24.0.10
SCP_IP=172.24.0.11
AMF_IP=172.24.0.12
AUSF_IP=172.24.0.13
UDM_IP=172.24.0.14
UDR_IP=172.24.0.15
PCF_IP=172.24.0.16
BSF_IP=172.24.0.17
NSSF_IP=172.24.0.18
SMF_IP=172.24.0.20
UPF_IP=172.24.0.21
UPF_N6_IP=172.25.0.2

# UE -> DN test target (only reachable via UPF N6)
UE_DN_TOOLS_IP=172.25.0.3

# ============ S1-N2 PROTOCOL CONVERTER ============
S1N2_IP=172.24.0.30

# ============ SMF / DNS ============
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4
PCSCF_IP=172.24.0.20

# ============ UPF TUN/TAP ============
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2

# ============ UE ============
UE_IPV4_INTERNET=192.168.100.0/24
UE_IPV4_IMS=192.168.101.0/24
MAX_NUM_UE=1024

# ============ 4G/freeDiameter (placeholders for sed) ============
PCRF_IP=172.24.0.2
PCRF_BIND_PORT=3868
OCS_IP=172.24.0.2
OCS_BIND_PORT=3869
OSMOEPDG_IP=172.24.0.2
